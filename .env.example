# ==============================================================================
# KAVACH - AI-Powered Welfare & Workload Analysis Platform
# Environment Configuration Template (FR-8)
# ==============================================================================

# --- Frontend Parameters ---
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCKS=false

# --- Backend Application Parameters ---
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# --- Security and Authentication ---
# Generate using: openssl rand -hex 32
JWT_SECRET=replace_with_a_unique_32_plus_character_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Local demonstration only. Keep false in production until an identity provider is configured.
DEMO_AUTH_ENABLED=false

# --- Database Connection Configuration ---
POSTGRES_USER=kavach
POSTGRES_PASSWORD=replace_with_a_unique_database_password
POSTGRES_DB=kavach_welfare
DATABASE_URL=postgresql://kavach:replace_with_a_unique_database_password@localhost:5432/kavach_welfare

# --- AI & LLM Service Providers ---
# RAG LLM integration keys
LLM_API_KEY=your_mock_llm_api_provider_key
VECTOR_DB_URL=http://localhost:6333

# --- System Feature Flags (FR-52) ---
USE_MOCK_API=false
ENABLE_AI=true
ENABLE_RAG=true
ENABLE_BIOMETRIC=true
