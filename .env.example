# ==============================================================================
# KAVACH - AI-Powered Welfare & Workload Analysis Platform
# Environment Configuration Template (FR-8)
# ==============================================================================

# --- Frontend Parameters ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=false

# --- Backend Application Parameters ---
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# --- Security and Authentication ---
# Generate using: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_sign_key_for_development_purposes_only_change_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database Connection Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kavach_welfare
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kavach_welfare

# --- AI & LLM Service Providers ---
# RAG LLM integration keys
LLM_API_KEY=your_mock_llm_api_provider_key
VECTOR_DB_URL=http://localhost:6333

# --- System Feature Flags (FR-52) ---
USE_MOCK_API=false
ENABLE_AI=true
ENABLE_RAG=true
ENABLE_BIOMETRIC=true
